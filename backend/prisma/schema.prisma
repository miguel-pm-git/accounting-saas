  chart_accounts      chart_accounts      @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ledger_account")
  companies           companies           @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ledger_company")
  journal_entry_items journal_entry_items @relation(fields: [journal_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ledger_item")

  @@index([journal_item_id], map: "fk_ledger_item")
  @@index([account_id], map: "idx_ledger_account")
  @@index([account_id, movement_date], map: "idx_ledger_account_date")
  @@index([company_id], map: "idx_ledger_company")
  @@index([movement_date], map: "idx_ledger_date")
}

