  chart_accounts   chart_accounts           @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_item_account")
  journal_entries  journal_entries          @relation(fields: [entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_item_entry")
  ledger_movements ledger_movements[]

  @@index([account_id], map: "idx_item_account")
  @@index([entry_id], map: "idx_item_entry")
  @@index([type], map: "idx_item_type")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model journal_reversals {
  id                                                                   BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  company_id                                                           BigInt          @db.UnsignedBigInt
  original_entry_id                                                    BigInt          @unique(map: "uk_reversal_original") @db.UnsignedBigInt
  reversal_entry_id                                                    BigInt          @unique(map: "uk_reversal_generated") @db.UnsignedBigInt
  reason                                                               String          @db.VarChar(500)
  reversed_by_user_id                                                  BigInt          @db.UnsignedBigInt
  reversed_at                                                          DateTime        @default(now()) @db.DateTime(0)
  created_at                                                           DateTime        @default(now()) @db.DateTime(0)
  companies                                                            companies       @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reverse_company")
  journal_entries_journal_reversals_reversal_entry_idTojournal_entries journal_entries @relation("journal_reversals_reversal_entry_idTojournal_entries", fields: [reversal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reverse_generated")
  journal_entries_journal_reversals_original_entry_idTojournal_entries journal_entries @relation("journal_reversals_original_entry_idTojournal_entries", fields: [original_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reverse_original")
  users                                                                users           @relation(fields: [reversed_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reverse_user")

  @@index([company_id], map: "idx_reverse_company")
  @@index([company_id, reversed_at], map: "idx_reverse_company_date")
  @@index([reversed_at], map: "idx_reverse_date")
  @@index([reversed_by_user_id], map: "idx_reverse_user")
}

model ledger_movements {
  id                  BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  company_id          BigInt              @db.UnsignedBigInt
  account_id          BigInt              @db.UnsignedBigInt
  journal_item_id     BigInt              @db.UnsignedBigInt
  movement_date       DateTime            @db.Date
  debit               Decimal?            @default(0.00) @db.Decimal(18, 2)
  credit              Decimal?            @default(0.00) @db.Decimal(18, 2)
  running_balance     Decimal             @db.Decimal(18, 2)
  created_at          DateTime?           @default(now()) @db.DateTime(0)
  chart_accounts      chart_accounts      @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ledger_account")
  companies           companies           @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ledger_company")
  journal_entry_items journal_entry_items @relation(fields: [journal_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ledger_item")

  @@index([journal_item_id], map: "fk_ledger_item")
  @@index([account_id], map: "idx_ledger_account")
  @@index([account_id, movement_date], map: "idx_ledger_account_date")
  @@index([company_id], map: "idx_ledger_company")
  @@index([movement_date], map: "idx_ledger_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
