  journal_entries_journal_reversals_reversal_entry_idTojournal_entries journal_entries @relation("journal_reversals_reversal_entry_idTojournal_entries", fields: [reversal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reverse_generated")
  journal_entries_journal_reversals_original_entry_idTojournal_entries journal_entries @relation("journal_reversals_original_entry_idTojournal_entries", fields: [original_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reverse_original")
  users                                                                users           @relation(fields: [reversed_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reverse_user")

  @@index([company_id], map: "idx_reverse_company")
