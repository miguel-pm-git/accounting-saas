  journal_entries  journal_entries          @relation(fields: [entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_item_entry")
  ledger_movements ledger_movements[]

  @@index([account_id], map: "idx_item_account")
  @@index([entry_id], map: "idx_item_entry")
  @@index([type], map: "idx_item_type")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model journal_reversals {
  id                                                                   BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  company_id                                                           BigInt          @db.UnsignedBigInt
  original_entry_id                                                    BigInt          @unique(map: "uk_reversal_original") @db.UnsignedBigInt
  reversal_entry_id                                                    BigInt          @unique(map: "uk_reversal_generated") @db.UnsignedBigInt
