model suppliers {
  id              BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  company_id      BigInt     @db.UnsignedBigInt
  name            String     @db.VarChar(255)
  document_number String?    @db.VarChar(20)
  email           String     @db.VarChar(255)
  phone           String?    @db.VarChar(30)
  created_at      DateTime?  @default(now()) @db.DateTime(0)
  payables        payables[]
  companies       companies  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_suppliers_company")

  @@index([company_id], map: "idx_supplier_company")
  @@unique([company_id, document_number], map: "uk_supplier_company_doc")
}

model users {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  company_id        BigInt              @db.UnsignedBigInt
  name              String              @db.VarChar(255)
  email             String              @db.VarChar(255)
  active            Boolean             @default(true)
  password_hash     String              @db.VarChar(255)
  role              UserRole            @default(EMPLOYEE)
  status            UserStatus          @default(ACTIVE)
  created_at        DateTime?           @default(now()) @db.DateTime(0)
  audit_logs        audit_logs[]
  journal_entries   journal_entries[]
  journal_reversals journal_reversals[]

  @@unique([company_id, id], map: "uk_user_company")
}

enum payable_payment_method {
  CASH
  PIX
  TED
  DOC
  BANK_TRANSFER
  CHECK
  CREDIT_CARD
  DEBIT_CARD
  OTHER
}

model payable_payments {
  id                  BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  payable_id          BigInt                   @db.UnsignedBigInt
  payment_date        DateTime                 @db.Date
  amount              Decimal                  @db.Decimal(18, 2)
  payment_method      payable_payment_method?
  document_number     String?                  @db.VarChar(100)
  notes               String?                  @db.VarChar(1000)
  journal_entry_id    BigInt?                  @db.UnsignedBigInt
  created_at          DateTime                 @default(now()) @db.DateTime(0)

  payables            payables                 @relation(fields: [payable_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payment_payable")
  journal_entries     journal_entries?         @relation(fields: [journal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payment_journal")

  @@index([payable_id], map: "idx_payment_payable")
  @@index([payment_date], map: "idx_payment_date")
  @@index([journal_entry_id], map: "idx_payment_journal")
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  ACCOUNTANT
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum chart_accounts_category {
  ATIVO
  PASSIVO
  PATRIMONIO
  RECEITA
  DESPESA
}

enum journal_entry_items_type {
  DEBIT
  CREDIT
}

enum cash_movements_type {
  INCOME
  EXPENSE
}

enum audit_logs_operation {
  INSERT
  UPDATE
  DELETE
  POST
  REVERSE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  CANCEL
}

enum journal_entries_source_module {
  MANUAL
  PAYABLE
  RECEIVABLE
  BANK
  PIX
  INVOICE
}

enum journal_entries_status {
  DRAFT
  POSTED
  REVERSED
}

enum payables_status {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

enum receivables_status {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}
